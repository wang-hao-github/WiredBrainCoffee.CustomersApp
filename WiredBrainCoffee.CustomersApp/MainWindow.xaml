<Window x:Class="WiredBrainCoffee.CustomersApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WiredBrainCoffee.CustomersApp" 
        xmlns:controls="clr-namespace:WiredBrainCoffee.CustomersApp.Controls"
        xmlns:views="clr-namespace:WiredBrainCoffee.CustomersApp.View"
        xmlns:viewModel="clr-namespace:WiredBrainCoffee.CustomersApp.ViewModel"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" FontSize="20" >
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModel:CustomersViewModel}" >
            <views:CustomersView></views:CustomersView>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:ProductsViewModel}" >
            <views:ProductsView></views:ProductsView>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!--Main menu-->
        <Menu Grid.Row="0" FontSize="20">
            <MenuItem Header="_View" >
                <MenuItem Header="_Customers" Command="{Binding SelecteViewModelCommand}" CommandParameter="{Binding CustomersViewModel}" ></MenuItem>
                <MenuItem Header="_Products" Command="{Binding SelecteViewModelCommand}" CommandParameter="{Binding ProductsViewModel}" ></MenuItem>
            </MenuItem>
        </Menu>
        <!--Header-->
        <controls:HeaderControl Grid.Row="1"></controls:HeaderControl>
        <!--SeletedView-->
        <ContentControl Grid.Row="2" Content="{Binding SelectedViewModel}"/>
        <!--Status bar-->
        <StatusBar Grid.Row="3">
            <StatusBarItem FontSize="20" Content="(c) Wired Brain Coffee"/>
        </StatusBar>
    </Grid>
</Window>
